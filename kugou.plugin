#!name = 酷狗概念版全自动签到
#!desc = 开启后，去App手动签到一次。已修复弹窗轰炸，支持人性化时间设置。
#!author = AI
#!icon = https://raw.githubusercontent.com/Ourem/Icon/master/kugou.png
#!date = 2026-07-04

[MITM]
hostname = *.kugou.com

[Argument]
cron_hour = input, "8", tag = ⏰ 签到时间：小时(24小时制), desc = 请输入小时数字。如上午8点填8，下午8点填20
cron_min = input, "30", tag = ⏰ 签到时间：分钟, desc = 请输入分钟数字。如半点填30，整点填0

[Script]
# 拦截并静默保存签到数据
http-request ^https?:\/\/.*\.kugou\.com\/.*(checkin|sign|vip|welfare) script-path=https://raw.githubusercontent.com/xiangjiaoxun/loon/main/kugou.js, requires-body=true, tag=酷狗签到抓包

# 动态组合时间定时运行
cron "{cron_min} {cron_hour} * * *" script-path=https://raw.githubusercontent.com/xiangjiaoxun/loon/main/kugou.js, tag=酷狗自动签到
