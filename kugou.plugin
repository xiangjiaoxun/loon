#!name = 酷狗概念版全自动签到
#!desc = 开启后，去App手动签到一次。已修复时间不运行与重复签到不提示的Bug。
#!author = AI
#!icon = https://raw.githubusercontent.com/Ourem/Icon/master/kugou.png
#!date = 2026-07-04

[MITM]
hostname = *.kugou.com

[Argument]
cron_time = input, "30 8", tag = ⏰ 设定每日签到时间, desc = 格式为“分钟 小时”。例如：上午8点半填“30 8”；下午8点点半填“30 20”

[Script]
# 拦截并静默保存签到数据
http-request ^https?:\/\/.*\.kugou\.com\/.*(checkin|sign|vip|welfare) script-path=https://raw.githubusercontent.com/xiangjiaoxun/loon/main/kugou.js, requires-body=true, tag=酷狗签到抓包

# 动态定时运行
cron "{cron_time} * * *" script-path=https://raw.githubusercontent.com/xiangjiaoxun/loon/main/kugou.js, tag=酷狗自动签到
