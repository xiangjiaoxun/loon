#!name = 酷狗概念版全自动签到
#!desc = 开启后，去App手动签到一次，提示捕获成功后即可每天全自动运行。
#!author = AI
#!icon = https://raw.githubusercontent.com/Ourem/Icon/master/kugou.png
#!date = 2026-07-04

[MITM]
hostname = *.kugou.com

[Script]
# 拦截并保存签到数据
http-request ^https?:\/\/.*\.kugou\.com\/.*(checkin|sign|vip|welfare) script-path=https://raw.githubusercontent.com/xiangjiaoxun/Loon/main/kugou.js, requires-body=true, tag=酷狗签到抓包

# 每天早上 8:30 全自动运行签到
cron "30 8 * * *" script-path=https://raw.githubusercontent.com/xiangjiaoxun/Loon/main/kugou.js, tag=酷狗自动签到
