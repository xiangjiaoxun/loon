#!name = 酷狗概念版全自动签到
#!desc = 开启后，去App手动签到一次。支持自定义克隆时间与关闭通知。
#!author = AI
#!icon = https://raw.githubusercontent.com/Ourem/Icon/master/kugou.png
#!date = 2026-07-04

[MITM]
hostname = *.kugou.com

[Argument]
cron_time = input, "30 8 * * *", tag = 自定义签到时间(Cron), desc = 默认每天早上 8:30 执行。格式: 分 时 天 月 周
capture_notify = switch, true, tag = 允许抓包成功提示, desc = 关闭后，疯狂点击App时不再弹窗轰炸

[Script]
# 拦截并保存签到数据（传入控制弹窗的参数）
http-request ^https?:\/\/.*\.kugou\.com\/.*(checkin|sign|vip|welfare) script-path=https://raw.githubusercontent.com/xiangjiaoxun/loon/main/kugou.js, requires-body=true, argument=capture_notify={capture_notify}, tag=酷狗签到抓包

# 动态定时运行签到
cron "{cron_time}" script-path=https://raw.githubusercontent.com/xiangjiaoxun/loon/main/kugou.js, tag=酷狗自动签到
